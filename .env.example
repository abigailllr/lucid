DEFAULT_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=
GEMINI_API_KEY=

ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro

OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

ENABLE_HANDWRITING_OCR=true
GOOGLE_VISION_CREDENTIALS_PATH=google-vision-credentials.json

TTS_VOICE=nova

CACHE_TTL_SECONDS=300
CACHE_HASH_DISTANCE=5
SESSION_TTL_SECONDS=3600
PURGE_INTERVAL_SECONDS=300

CONFIDENCE_THRESHOLD=0.55

MIN_CAPTURE_INTERVAL_MS=1200
DEVICE_TEMP_THROTTLE_C=70.0
DEVICE_TEMP_CRITICAL_C=80.0
LOW_BATTERY_PCT=15.0
